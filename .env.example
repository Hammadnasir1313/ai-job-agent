# Copy this file to .env and fill in your own values. Never share .env.

# Google Gemini (free key: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# WasenderAPI (WhatsApp)
WASENDER_API_KEY=your_session_api_key
WASENDER_PERSONAL_TOKEN=your_personal_access_token
WASENDER_WEBHOOK_SECRET=filled_in_automatically_by_start_agent
MY_WHATSAPP=+923001234567

# Gmail (App Password: https://myaccount.google.com/apppasswords)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_16_letter_app_password

# About you (used in application emails)
MY_NAME=Your Name
MY_PHONE=+92 300 1234567
RESUME_FILE=C:\path\to\your_cv.pdf
